# Copy to infra/.env on the VM. Never commit the real file.
SEDERYOM_DOMAIN=sederyom.example.com
POSTGRES_USER=sederyom
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sederyom

# Everything below mirrors server/.env.example (minus DATABASE_URL, which
# docker-compose composes from the Postgres settings above).
# Required, even though the VM's own scheduler does not use it: it guards
# /cron/tick for anything external. Hex, not base64 — it is passed as a
# query parameter. openssl rand -hex 32
CRON_SECRET=CHANGE_ME
LOG_LEVEL=info

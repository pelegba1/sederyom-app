# --- core ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TIMEZONE=Asia/Jerusalem

# --- database ---
DATABASE_URL=postgresql://sederyom:CHANGE_ME@db:5432/sederyom?schema=public

# --- security (design-doc §8) ---
# Required. Guards /cron/tick, the only route outside /v2 that does any work;
# devices carry their own tokens. Hex, not base64 — it is passed as a query
# parameter. At least 16 characters, or the server refuses to start.
# openssl rand -hex 32
CRON_SECRET=CHANGE_ME

# --- the followed classes (plan Phase 2) ---
SCHEDULER_ENABLED=true
POLL_SHAHAF_ACTIVE_MIN=15
POLL_SHAHAF_IDLE_MIN=60
# A class's exam calendar.
POLL_SCHOOL_SITE_MIN=60
ACTIVE_WINDOW_START=06:00
ACTIVE_WINDOW_END=22:30
SHAHAF_WEEKS_AHEAD=3
CLASS_POLLS_PER_TICK=8

# --- the chat connection (design: docs/superpowers/specs/2026-11-04-chat-connection-design.md) ---
# The address a chat reaches this server at, as a bare https origin; the OAuth
# metadata and /mcp name it. Defaults to http://localhost:3000, which is right
# for a local server only: in production a non-https address makes the chat's
# routes answer 503 not_configured, with a warning at startup. Uncomment and set
# it wherever the server is deployed.
# PUBLIC_URL=https://<domain>
# A fixed code that connects a chat to the demo data, only while a store review
# is on. 8 characters of A-Z (no I, O) and 2-9. An invalid value only warns and
# turns the demo off. Leave it unset to turn the demo off.
# CHAT_DEMO_CODE=

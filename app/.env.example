# Copy to app/.env for local builds. For EAS, configure these variables in
# the app project's development/production environment (Sensitive visibility).
# Only the URL is built into the app: every phone registers as a device on /v2
# and keeps its own credential. No server token belongs here.
EXPO_PUBLIC_SEDERYOM_API_URL=https://sederyom.example.com
# Optional path to Firebase's Android config. On EAS use a File variable with
# this name; locally you can also place the file at app/google-services.json.
# GOOGLE_SERVICES_JSON=/path/to/google-services.json

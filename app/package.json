{
  "name": "sederyom-app",
  "version": "2.1.0",
  "private": true,
  "main": "index.js",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-notifications"],
        "exclude": ["expo-widgets", "@expo/ui"]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "build:production": "npx eas-cli build --platform android --profile production",
    "build:ios": "npx eas-cli build --platform ios --profile testflight --auto-submit",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/assistant": "^0.4.1",
    "@expo-google-fonts/heebo": "^0.4.2",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo-google-fonts/secular-one": "^0.4.1",
    "@expo/ui": "~57.0.26",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/core": "^7.21.13",
    "@react-navigation/elements": "^2.9.40",
    "@react-navigation/material-top-tabs": "~7.6.17",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@sederyom/shared": "*",
    "@tanstack/react-query": "^5.102.8",
    "expo": "^57.0.0",
    "expo-application": "~57.0.3",
    "expo-background-task": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.27",
    "luxon": "^3.7.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
